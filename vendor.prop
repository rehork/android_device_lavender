# RIL
vendor.rild.libpath=/vendor/lib64/libril-qc-hal-qmi.so

ro.config.media_vol_default=8
ro.config.media_vol_steps=25
ro.config.vc_call_vol_default=5
ro.config.vc_call_vol_steps=6
vendor.audio.adm.buffering.ms=6

# Bluetooth
bluetooth.device.class_of_device=90,2,12
bluetooth.hardware.power.operating_voltage_mv=3700
vendor.qcom.bluetooth.soc=cherokee
persist.vendor.qcom.bluetooth.a2dp_offload_cap=sbc-aac-aptx-aptxhd-ldac
persist.vendor.qcom.bluetooth.aac_frm_ctl.enabled=true
persist.vendor.service.bdroid.sibs=false

# Camera
vendor.video.disable.ubwc=1
persist.vendor.camera.preview.ubwc=0
persist.vendor.camera.isp.clock.optmz=0
persist.vendor.camera.isp.turbo=1
persist.vendor.camera.imglib.usefdlite=1
persist.vendor.camera.expose.aux=1
persist.vendor.camera.HAL3.enabled=1
persist.vendor.camera.thirdpartyeis_enabled=1
persist.vendor.camera.isp.dualisp=1
persist.vendor.camera.manufacturer=Xiaomi
persist.vendor.camera.model=Redmi Note 7
persist.vendor.camera.awb.sync=2
persist.vendor.camera.perflock.enable=0
persist.vendor.camera.stats.test=0
persist.sys.camera.camera2=true
vidc.enc.dcvs.extra-buff-count=3
persist.vendor.camera.logLevel=0
persist.vendor.camera.sensor=0
persist.vendor.camera.logInfoMask=false


#add for color invert
ro.vendor.df.effect.conflict=1
persist.sys.df.extcolor.proc=0
#paper mode
sys.paper_mode_max_level=255
sys.tianma_nt36672a_offset=6
sys.tianma_nt36672a_length=42
sys.boe_td4320_offset=-9
sys.boe_td4320_length=42
sys.shenchao_nt36672a_offset=-10
sys.shenchao_nt36672a_length=38

# Charger
ro.charger.enable_suspend=true

# Dalvik
dalvik.vm.dex2oat64.enabled=true
dalvik.vm.systemuicompilerfilter=speed
dalvik.vm.dex2oat-minidebuginfo=false
dalvik.vm.minidebuginfo=false

# Display
debug.sf.enable_transaction_tracing=false
debug.sf.use_phase_offsets_as_durations=1
debug.sf.late.sf.duration=10500000
debug.sf.late.app.duration=16600000
debug.sf.early.sf.duration=16600000
debug.sf.early.app.duration=16600000
debug.sf.earlyGl.sf.duration=16600000
debug.sf.earlyGl.app.duration=16600000
#debug.gralloc.gfx_ubwc_disable=1
debug.gralloc.enable_fb_ubwc=1
#sdm.debug.rotator_disable_ubwc=1
dev.pm.dyn_samplingrate=1
sdm.debug.disable_skip_validate=1
ro.colorpick_adjust=true
vendor.display.disable_skip_validate=1
debug.sf.enable_hwc_vds=0
debug.sf.auto_latch_unsignaled=0
debug.sf.enable_egl_image_tracker=true
#debug.sf.disable_client_composition_cache=1
debug.sf.predict_hwc_composition_strategy=0
debug.sf.latch_unsignaled=1
#debug.sf.enable_gl_backpressure=0
debug.mdpcomp.logs=0
# Rendering
debug.enable.sglscale=1
debug.sf.recomputecrop=0
#vendor.display.disable_metadata_dynamic_fps=1
#vendor.display.disable_partial_split=1
ro.opengles.version=196610
ro.surface_flinger.has_wide_color_display=true
ro.vendor.display.ad=1
ro.vendor.display.ad.sdr_calib_data=/data/vendor/display/ad_calib.cfg
ro.vendor.display.sensortype=2
ro.vendor.display.cabl=0
vendor.display.enable_default_color_mode=1
vendor.display.disable_rotator_downscale=1
vendor.gralloc.disable_ahardware_buffer=1
persist.demo.hdmirotationlock=false
vendor.display.disable_hw_recovery_dump=1

# Disable vsync for cpu rendered apps
debug.cpurend.vsync=false

# DPM
persist.vendor.dpm.loglevel=0

# DRM
drm.service.enabled=true
media.mediadrmservice.enable=true

# FRP
ro.frp.pst=/dev/block/bootdevice/by-name/frp

# FS-verity
ro.apk_verity.mode=2

# Fwk detect
ro.vendor.qti.va_aosp.support=1

# GPS
persist.backup.ntpServer="0.pool.ntp.org"

# Incremental FS
ro.incremental.enable=1

# Keystore
ro.hardware.keystore_desede=true

# HEH filename encryption is being dropped
ro.crypto.volume.filenames_mode=aes-256-cts

# SPU
vendor.gatekeeper.disable_spu=true

# IMS
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1

# Media
persist.mm.enable.prefetch=true
debug.stagefright.ccodec=1
debug.stagefright.omx_default_rank=0
vendor.media.target.version=2
vendor.mm.enable.qcom_parser=16777215
vendor.vidc.enc.disable.pq=true

# Multi-Gen LRU
persist.device_config.mglru_native.lru_gen_config=core

# Netflix custom property
ro.netflix.bsp_rev=Q660-13149-1

# Network manager
ro.telephony.iwlan_operation_mode=legacy

# Perf
ro.vendor.extension_library=libqti-perfd-client.so
#ro.vendor.perf.scroll_opt=true
persist.sys.perf.scroll_opt=true
persist.sys.perf.scroll_opt.heavy_app=1
vendor.perf.framepacing.enable=1


# Disable Skia tracing by default
debug.hwui.skia_atrace_enabled=false
renderthread.skia.reduceopstasksplitting=true

# Radio
persist.radio.multisim.config=dsds
persist.vendor.data.iwlan.enable=true
persist.vendor.data.mode=concurrent
persist.vendor.radio.apm_sim_not_pwdn=1
persist.vendor.radio.atfwd.start=true
persist.vendor.radio.custom_ecc=1
persist.vendor.radio.data_con_rprt=1
persist.vendor.radio.mt_sms_ack=30
persist.vendor.radio.rat_on=combine
persist.vendor.radio.report_codec=1
persist.vendor.radio.sib16_support=1
ro.telephony.block_binder_thread_on_incoming_calls=false
ro.telephony.default_network=22,22
ro.vendor.use_data_netmgrd=true
persist.vendor.ssr.restart_level=ALL_ENABLE
#persist.vendor.radio.calls.on.ims=1
#persist.radio.volte.dan_support=true
#persist.vendor.radio.enableadvancedscan=true

# Sensors
ro.vendor.sdk.sensors.gestures=false
ro.vendor.sensors.cmc=false
ro.vendor.sensors.facing=false
ro.vendor.sensors.dev_ori=true
ro.vendor.sensors.pmd=true
ro.vendor.sensors.sta_detect=true
ro.vendor.sensors.mot_detect=true
ro.vendor.sensors.smd=false

# Set system properties identifying the chipset
ro.soc.manufacturer=Qualcomm
ro.soc.model=SDM660

# Render Engine
debug.hwui.renderer=skiagl
debug.renderengine.backend=skiaglthreaded

# Smoothens UI
persist.service.lgospd.enable=0

# Sensors
persist.vendor.sensors.debug.hal=0

# SSR
persist.vendor.ssr.restart_level=ALL_ENABLE

# Surfaceflinger
ro.surface_flinger.use_color_management=true
debug.performance.tuning=1 
ro.surface_flinger.enable_frame_rate_override=false
#ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.max_virtual_display_dimension=4096

# USB
vendor.usb.rmnet.func.name=rmnet_bam
vendor.usb.rmnet.inst.name=rmnet
vendor.usb.rndis.func.name=rndis_bam
vendor.usb.product_string=Redmi Note 7
vendor.usb.use_gadget_hal=0

# Zygote
zygote.critical_window.minute=10
