# Feature flags
persist.sys.fflag.override.settings_enable_monitor_phantom_procs=false

# Radio
DEVICE_PROVISIONED=1
persist.sys.fflag.override.settings_network_and_internet_v2=true
ril.subscription.types=NV,RUIM
telephony.lteOnCdmaDevice=1
persist.sys.fflag.override.settings_provider_model=false
ro.telephony.block_binder_thread_on_incoming_calls=false
persist.vendor.qti.telephony.vt_cam_interface=2

# Display
debug.egl.hw=0
debug.sf.hw=0
debug.sf.enable_hwc_vds=0
debug.gralloc.gfx_ubwc_disable=1
debug.gralloc.enable_fb_ubwc=0
sdm.debug.rotator_disable_ubwc=1
#dev.pm.dyn_samplingrate=1
persist.demo.hdmirotationlock=false
sdm.debug.disable_skip_validate=1
ro.colorpick_adjust=true
vendor.display.disable_skip_validate=1
debug.renderengine.backend=skiaglthreaded
debug.hwui.renderer=skiagl
debug.hwui.skia_atrace_enabled=false
qemu.sf.lcd_density=420

# Media
debug.stagefright.ccodec=1
vendor.media.target.version=2
debug.stagefright.omx_default_rank=0
persist.mm.enable.prefetch=true
mm.enable.smoothstreaming=true
mm.enable.sec.smoothstreaming=true
vendor.mm.enable.qcom_parser=13631471
persist.mm.enable.prefetch=true
vidc.enc.target_support_bframe=1
vendor.vidc.enc.disable_bframes=1
vendor.vidc.dec.enable.downscalar=0
vendor.vidc.enc.disable.pq=true

# Disable vsync for cpu rendered apps
debug.cpurend.vsync=false

# Qcom
ro.vendor.qti.va_aosp.support=1

# SSR Restart
persist.vendor.ssr.restart_level=ALL_ENABLE

# USB
persist.adb.nonblocking_ffs=0

# WiFi
wifi.interface=wlan0

# Telephony
ro.telephony.handle_audio_direction_changes_between_call_state_changes=false
