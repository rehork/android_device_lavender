allow hal_audio_default sysfs:dir r_dir_perms;
get_prop(hal_audio_default, boot_status_prop)
get_prop(hal_audio_default, dirac_prop)
set_prop(hal_audio_default, dirac_prop)
get_prop(hal_audio_default, elliptic_ultrasound_prop)
allow hal_audio_default mnt_vendor_file:dir search;
allow hal_audio_default property_socket:sock_file { write };
allow hal_audio_default property_socket:sock_file write;
allow hal_audio_default vendor_audio_prop:property_service { set };
